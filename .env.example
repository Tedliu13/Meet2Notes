# Meet2Notes only listens on the loopback interface by default.
M2N_HOST=127.0.0.1
M2N_PORT=8765
M2N_LOG_LEVEL=INFO
# Coolify Compose defaults this to true to retain native runtime stderr.
M2N_LLAMACPP_VERBOSE=false
M2N_MAX_UPLOAD_MB=2048
# 0 means no application upload size limit (proxy and available disk still apply).
M2N_MAX_HEAVY_JOBS=4
# Coolify Compose enables hosted mode and supplies /data and /models mounts.
# Desktop runs keep this disabled.
M2N_HOSTED=false
M2N_ALLOWED_HOSTS=meet2notes.ncdrcc.com
M2N_AUTH_USERNAME=
M2N_AUTH_PASSWORD=
# Generate a Fernet key; preserve separately for encrypted credential restore.
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Paste the complete 44-character result including trailing '='; not a password.
M2N_SECRETS_KEY=
M2N_CPU_LIMIT=8
M2N_MEMORY_LIMIT=32g
M2N_CPU_THREADS=2
# M2N_DATA_DIR=/absolute/path/to/private/local/data
# M2N_MODELS_DIR=D:\Meet2Notes\Models
# M2N_FFMPEG_PATH=/absolute/path/to/ffmpeg
# Required only to download Pyannote Community-1 after accepting its model terms.
# M2N_PYANNOTE_TOKEN=hf_your_token_here
